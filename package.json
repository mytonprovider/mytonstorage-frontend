    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
