{
  "name": "mytonstorage-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Web app for storing files in TON Storage",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
